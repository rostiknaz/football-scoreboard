{
    "name": "nazymko/football-scoreboard",
    "description": "Live Football World Cup Score Board: start games, update scores, finish games and get a summary ordered by total score.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rostyslav Nazymko",
            "email": "rostiknaz@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "Nazymko\\ScoreBoard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nazymko\\ScoreBoard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4"
    }
}
